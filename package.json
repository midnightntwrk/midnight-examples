{
  "name": "mn-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Official Midnight example DApps and smart contracts, verified to compile and run against a pinned toolchain.",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "examples/*",
    "examples/*/ui",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/each-workspace.mjs build --include \"@midnightntwrk/mnkit-*\"",
    "build:packages": "node scripts/each-workspace.mjs build --include \"@midnightntwrk/mnkit-*\"",
    "new:example": "node scripts/new-example.mjs",
    "new:ui": "node scripts/new-ui.mjs",
    "spec:lint": "node scripts/spec-lint.mjs",
    "toolchain:check": "node scripts/toolchain-check.mjs",
    "test:engine": "npm test -w mnkit --",
    "fixtures:regen": "node packages/mnkit/test/fixtures/regen.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "wallets:new": "npm run wallets:new -w @midnightntwrk/mnkit-wallet --",
    "preseed:cut": "npm run preseed:cut -w @midnightntwrk/mnkit-wallet --",
    "fund:wallet": "npm run fund:wallet -w @midnightntwrk/mnkit-wallet --",
    "compile": "node scripts/each-workspace.mjs compile",
    "compile:fast": "node scripts/each-workspace.mjs compile:fast",
    "typecheck": "node scripts/each-workspace.mjs typecheck",
    "test": "npm run test --workspaces --if-present",
    "test:sim": "npm run test:sim --workspaces --if-present",
    "test:local": "npm run test:local --workspaces --if-present",
    "test:preprod": "npm run test:preprod --workspaces --if-present",
    "test:preview": "npm run test:preview --workspaces --if-present"
  },
  "devDependencies": {
    "bn.js": "5.2.5",
    "vite": "6.4.5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1",
    "@midnight-ntwrk/zkir-v2": "2.1.1",
    "vite-plugin-top-level-await": {
      "@swc/core": "1.15.47",
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "@swc/core": false,
    "classic-level": false,
    "cpu-features": false,
    "dtrace-provider": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "ssh2": false
  }
}
