# Copy to .env.custom.postfork (gitignored): the custom network's endpoints
# after the fork. Select it per run with
#
#   MIDNIGHT_ENV_FILE=.env.custom.postfork npm run test:custom
#
# It is read on top of .env.custom, so keep the wallet seeds in .env.custom
# only: the same wallets must be used on both sides of the fork. Copy all
# five endpoint lines even if they match .env.custom.prefork, so each file
# describes its side completely. See .env.custom.example.
#
# Never commit real endpoints: this repo is public.
MIDNIGHT_NETWORK_ID=replace-with-the-post-fork-network-id
MIDNIGHT_NODE=https://rpc.example.invalid
MIDNIGHT_NODE_WS=wss://rpc.example.invalid
MIDNIGHT_INDEXER=https://indexer.example.invalid/api/v4/graphql
MIDNIGHT_INDEXER_WS=wss://indexer.example.invalid/api/v4/graphql/ws

# Optional: e.g. a proof server that matches this side's ledger version.
#MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
#MIDNIGHT_FAUCET=
