{
  "name": "@q3/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "compile": "node -e \"import('./scripts/compact.mjs').then(m => m.compile('contract/counter.compact', 'contract/managed/counter'))\"",
    "test:sim": "true",
    "test:local": "vitest run",
    "wait:dust": "tsx scripts/wait-for-dust.ts",
    "stack:check": "tsx scripts/stack-check.ts",
    "report": "tsx scripts/report.ts && tsx scripts/report-md.ts",
    "report:md": "tsx scripts/report-md.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0-rc.3",
    "@midnight-ntwrk/compact-runtime": "0.20.0",
    "@midnight-ntwrk/midnight-js-bundled-contract-module-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0-rc.2",
    "@midnight-ntwrk/testkit-js": "5.0.0-rc.2",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.4",
    "@midnightntwrk/wallet-sdk": "2.0.0-rc.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
