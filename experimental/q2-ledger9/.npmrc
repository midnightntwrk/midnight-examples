# Resolve only package versions published at least 7 days ago (needs npm
# 11.10+). Yarn exempted the first-party Midnight scopes, so release candidates
# could be installed within hours; npm has no per-scope exemption. To take an
# RC younger than 7 days, install with `npm install --min-release-age=0` and
# review the package-lock.json diff.
min-release-age=7
