# Copy to .env.preprod (gitignored). Preprod's indexer and node RPC are served by
# Blockfrost, and every request needs a Midnight Preprod project token:
# create one at https://blockfrost.io. Never commit the real value.
BLOCKFROST_PROJECT_ID=replace-with-your-midnight-preprod-project-id

# Seeds: the same roles as .env.stagenet.example, with MIDNIGHT_PREPROD_ in
# place of MIDNIGHT_STAGENET_. Fund the deployer/relayer with tNIGHT from
# https://midnight-tmnight-preprod.nethermind.dev/.
