# Copy to .env.mainnet (gitignored) to run the single-wallet suites on mainnet:
#
#   npm run test:mainnet    # from the repo root: the 7 single-wallet suites
#
# or `npm run test:mainnet` inside one of hello-world, calculator, election,
# secret-message, private-bid, token-transfers or zk-loan. The other examples
# need several wallets and have no mainnet script.
#
# THIS IS REAL MONEY. Never commit this file; this repo is public.
#
# ---------------------------------------------------------------------------
# Endpoints
# ---------------------------------------------------------------------------
# Mainnet goes through Blockfrost. Use a token from a Midnight MAINNET project
# (a preprod token does not work). It is added to every URL as ?project_id=.
BLOCKFROST_PROJECT_ID=replace-with-a-blockfrost-mainnet-project-token

# Optional: another mainnet indexer instead of Blockfrost's. Set both; they
# are used as given (no Blockfrost token added). The node stays on Blockfrost.
# Don't reuse .wallet-state/ across indexers: event ids can differ, so delete
# the mainnet-*.json file there when you switch.
#MIDNIGHT_INDEXER=https://indexer.example/api/v4/graphql
#MIDNIGHT_INDEXER_WS=wss://indexer.example/api/v4/graphql/ws

# Optional. How often a sync logs its progress ('sync progress' lines), in ms;
# default 30000, 0 turns it off.
#MIDNIGHT_SYNC_PROGRESS_MS=30000

# Optional. Defaults to http://127.0.0.1:6300; its version must match the
# mainnet ledger. Start one with `npm run proof:up` in any example.
#MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# ---------------------------------------------------------------------------
# The wallet (one: Alice)
# ---------------------------------------------------------------------------
# The recovery phrase, e.g. from Lace (space-separated words).
MIDNIGHT_MAINNET_ALICE_MNEMONIC=replace with the twenty four words of the recovery phrase

# The wallet's unshielded address, copied from Lace (mn_addr1...). Each suite
# derives the address from the mnemonic and stops before its first transaction
# unless the two are identical.
MIDNIGHT_MAINNET_ALICE_ADDRESS=replace-with-the-mn_addr-from-lace

# Mainnet has no faucet. The wallet must already hold at least
# MIDNIGHT_MIN_DUST DUST (default 60); the suites stop at once if it holds less.
# They never register NIGHT for DUST on mainnet. A wallet whose DUST comes from
# cNIGHT on Cardano holds no NIGHT on Midnight, so token-transfers skips its
# two NIGHT tests there.
#MIDNIGHT_MIN_DUST=60
