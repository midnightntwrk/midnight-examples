# Resolve only package versions published at least 7 days ago, so a malicious or
# broken release has time to be caught. Needs npm 11.10+; older npm ignores it
# (package.json devEngines warns). npm has no per-scope exemption: a coordinated
# Midnight version pass that needs a release younger than 7 days installs with
# `npm install --min-release-age 0` and reviews the package-lock.json diff.
min-release-age=7

# Dependency install scripts are all denied (package.json allowScripts. npm
# 11.21 reads it; 10.9 and 11.13 don't, and run them as before). None is needed:
# esbuild and @swc/core get their binaries from optional platform packages,
# classic-level loads a shipped prebuild, and the rest are optional native
# speedups or a version notice. npm lists any new dependency with an install
# script after `npm install`: review it, then `npm install-scripts deny <pkg>`
# (or approve, with the reason here).
