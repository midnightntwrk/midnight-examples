// Private tip jar: anyone can drop a shielded coin into the jar without
// saying who they are, and only the jar's owner can take coins out.
//
// Flow:
// - The owner deploys the jar with the token color it accepts. The
//   constructor stores only a hash of the owner's secret key (`owner`), never
//   the key and never the owner's wallet.
// - A tipper calls `tip(coin)` with a shielded coin of that color from their
//   own wallet. The contract takes custody of it and immediately re-sends it
//   to itself, so what lands in the public `pot` is a contract-owned coin
//   with a contract-derived nonce, not the tipper's coin. `tip` uses no
//   witness and records no identity at all: the contract never learns who
//   tipped, so it cannot leak it.
// - The owner calls `withdraw(tipKey)` once per pot entry. The circuit proves
//   knowledge of the secret behind `owner` and pays that coin to the
//   caller's own shielded wallet.
//
// Privacy model (see AGENTS.md for the full list of accepted leaks):
// - PRIVATE: who tipped. Nothing in the ledger is derived from the tipper's
//   wallet key, a tipper secret, or the tipper's coin nonce. The tipper's coin
//   is spent through Zswap, which reveals a nullifier, not the coin or owner.
// - PRIVATE: the owner's secret key. Only its domain-separated hash is stored.
// - PUBLIC: the value of each tip (each `pot` entry holds a full coin, value
//   included, because the contract needs the whole coin to spend it later),
//   the accepted token color, the number of tips, when each `tip` and
//   `withdraw` happened (circuit names are public), and which pot coin each
//   withdrawal took. So an observer sees "someone tipped 40" but not who.
// - RESIDUAL: `sendShielded` derives the new coin's nonce from the input
//   coin's nonce alone. Anyone who knows the nonce of the coin you tip (you,
//   and whoever sent or minted that coin to you) can recompute the pot
//   entry and recognise your tip. Re-nonce the coin in your own wallet first
//   (a shielded self-transfer, `splitShieldedCoin` in src/wallet.ts) and that
//   thread is cut. Likewise a withdrawal's payout nonce is derived from a
//   pot nonce that is public, so an observer who guesses the owner's wallet
//   key can confirm it received the payout. The owner is a public role here;
//   this design does not try to hide where the owner's money goes.

pragma language_version 0.23;
import CompactStandardLibrary;

// Hash of the owner's secret key, written once at deployment. `sealed` means
// no circuit can ever change it, so ownership cannot be transferred or hijacked.
export sealed ledger owner: Bytes<32>;

// The only token color the jar accepts, fixed at deployment. Tips of any
// other color are refused, so every pot entry is the same currency.
export sealed ledger tipColor: Bytes<32>;

// The coins the jar currently holds, keyed by each coin's own nonce.
// Every coin here is contract-owned and was re-nonced on the way in (see
// `reNonceToSelf`), so publishing it links nothing back to a tipper's wallet.
// The coin value IS public: that is the price of letting the contract spend
// these coins without anyone having to hand it a secret later.
export ledger pot: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

// The owner's secret key, read from the owner's private state. Only the
// constructor and `withdraw` call it. Tippers never call it, so a tipper's
// private state does not need a real key.
witness ownerSecretKey(): Bytes<32>;

// `acceptedColor` is a constructor argument, not a witness: it is meant to be
// public. The owner key comes from the witness so the raw secret never
// appears in the deploy transaction.
constructor(acceptedColor: Bytes<32>) {
    owner = disclose(ownerKey(ownerSecretKey()));
    tipColor = disclose(acceptedColor);
}

// Domain-separated owner key. The "private-tip-jar:owner:" prefix means the
// same secret, reused in another dapp with a different prefix, yields an
// unrelated key there. It is a `pure` circuit so the tests (and a UI) can
// compute the expected `owner` value off chain from the secret alone.
// Use a fresh secret per jar: with a shared secret, two jars would show the
// same `owner` value and so be linkable to one owner.
export pure circuit ownerKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "private-tip-jar:owner:"), sk]);
}

// Take custody of a coin received in this transaction and hand back an
// equivalent coin that the contract owns under a freshly derived nonce.
// Same technique as `reNonceToSelf` in examples/shielded-chips roulette.
// The caller must already have called receiveShielded on `coin`.
//
// mt_index is 0 because the incoming coin is not in the commitment tree yet;
// it is being created by this very transaction.
circuit reNonceToSelf(coin: ShieldedCoinInfo): ShieldedCoinInfo {
    const qualified = QualifiedShieldedCoinInfo {
        nonce: coin.nonce,
        color: coin.color,
        value: coin.value,
        mt_index: 0 as Uint<64>
    };
    const result = sendShielded(
        disclose(qualified),
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self()),
        disclose(coin.value) as Uint<128>
    );
    return result.sent;
}

// Anyone can tip. The tip is the whole of `coin`: to tip an exact amount, make
// a coin of that value in your wallet first (a self-transfer does this and
// re-nonces it at the same time).
//
// There is deliberately no caller check and no witness call here. Asking for
// an identity would only create something that could leak.
export circuit tip(coin: ShieldedCoinInfo): [] {
    // Both guards run before any coin moves. A failing assert is rejected
    // while the transaction is being built, so a bad tip costs nothing.
    assert(coin.color == tipColor, "Tips must be paid in the jar's token");
    assert(coin.value > 0, "A tip must be worth something");

    // `disclose` here does not write the tipper's coin to the ledger. It
    // acknowledges that the coin flows into a public effect (the Zswap offer
    // that moves it into the contract), which only carries commitments and
    // nullifiers. What reaches the ledger is the re-nonced coin below.
    receiveShielded(disclose(coin));

    // Never `insertCoin` the incoming coin itself: its nonce is the tipper's
    // nonce, and a coin nonce is enough to test which wallet funded it.
    const held = reNonceToSelf(coin);
    pot.insertCoin(
        disclose(held.nonce),
        disclose(held),
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
}

// The owner takes one coin out of the jar and into their own shielded wallet.
// One coin per call keeps the circuit small; call it once per pot entry.
export circuit withdraw(tipKey: Bytes<32>): [] {
    // Ownership is proven by knowing the secret behind `owner`. The secret is
    // only used inside the proof; the comparison result is all that matters.
    assert(ownerKey(ownerSecretKey()) == owner, "Only the owner can withdraw");

    // The key is public anyway (it is a pot key), so disclosing it is free.
    const key = disclose(tipKey);
    assert(pot.member(key), "No such tip in the jar");

    // `pot` holds the coin with the mt_index the ledger assigned when the tip
    // landed (insertCoin records it), so it can be spent with sendShielded.
    const coin = pot.lookup(key);

    // Pay the full coin to the caller's shielded wallet. `ownPublicKey()` is
    // the key of whoever submits the transaction, which the owner check above
    // has already restricted to the owner.
    sendShielded(
        coin,
        left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
        coin.value
    );
    pot.remove(key);
}
