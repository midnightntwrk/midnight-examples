    { "op": "impact", "guard": "%useCustomName.1", "inputs": ["0x91"] },
    { "op": "impact", "guard": "%useCustomName.1", "inputs": ["0xa1"] },
    { "op": "persistent_hash", "output": "%bytes.11", "alignment": [{ "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%sk.2", "%sk.3"] },
    { "op": "bytes_into_natives", "outputs": ["%t.12", "%t.13"], "bytes": "%bytes.11" },
