    { "op": "cond_select", "output": "%t.8", "bit": "%useCustomName.1", "a": "0x00", "b": "0x01" },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%customName.9", "guard": "%useCustomName.1" },
    { "op": "constrain_bits", "val": "%customName.9", "bits": 8 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%customName.10", "guard": "%useCustomName.1" },
