# Dependencies
node_modules/

# Build / TypeScript output
dist/
# Copies prepack puts in a package (scripts/pack-extras.mjs)
packages/mnkit/toolchain.json
packages/*/LICENSE

# Generated compiled-contract output (regenerated by `npm run compile`).
# NOTE: the .compact SOURCE files are committed on purpose - do not ignore them.
**/contract/managed/
**/contracts/managed/
# ZK keys/zkir copied into a UI's public/ by its copy:zk script
**/ui/public/managed/

# Local runtime state and secrets (never commit real env files)
**/logs/
**/midnight-level-db/
**/.env.preprod
**/.env.preview
**/.fast-sync-wallets/
# Deploy state from scripts/deploy.ts: private state and signing keys, and the
# local devnet's deploy records
**/.mnkit/
**/deployments/local.json
# Gate stamps, the background devnet lock and its reports (scripts/lib/gates.mjs)
**/.gates/
# scratch dir used while re-cutting a pre-seed bundle; only present mid-cut
preseed/.staging-*/

# OS / editor
.DS_Store
*.log
