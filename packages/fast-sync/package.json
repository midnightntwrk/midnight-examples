{
  "name": "@midnight-ntwrk/mnkit-wallet",
  "version": "0.2.0",
  "type": "module",
  "description": "Test wallets for Midnight projects: the MidnightWalletProvider, network config for local, preview and preprod, seed resolution, pre-seed fast sync and the DUST funding gate. Part of mnkit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-examples.git",
    "directory": "packages/fast-sync"
  },
  "homepage": "https://github.com/midnightntwrk/midnight-examples/tree/main/packages/fast-sync#readme",
  "bugs": "https://github.com/midnightntwrk/midnight-examples/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json && node ../../scripts/pack-extras.mjs add LICENSE",
    "postpack": "node ../../scripts/pack-extras.mjs remove LICENSE",
    "typecheck": "tsc --noEmit -p .",
    "wallets:new": "vite-node scripts/new-preprod-wallets.ts",
    "preseed:cut": "vite-node scripts/cut-preseed.ts",
    "fund:wallet": "vite-node scripts/fund-wallet.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@polkadot/api": "16.5.6",
    "@polkadot/types": "16.5.6",
    "@polkadot/util": "14.0.3",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@midnight-ntwrk/midnight-js-network-id": "~4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "~4.1.1",
    "@midnight-ntwrk/midnight-js-types": "~4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "~4.1.1",
    "@midnight-ntwrk/testkit-js": "~4.1.1",
    "@midnight-ntwrk/wallet-sdk": "~1.2.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite-node": "^6.0.0"
  }
}
