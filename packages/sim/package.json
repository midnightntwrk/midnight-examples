{
  "name": "@midnight-ntwrk/mnkit-sim",
  "version": "0.1.0",
  "type": "module",
  "description": "In-memory contract harness for Midnight tests: deploy and call a compiled Compact contract without a network, expect rejections, and check that no secret reaches public state. Part of mnkit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-examples.git",
    "directory": "packages/sim"
  },
  "homepage": "https://github.com/midnightntwrk/midnight-examples/tree/main/packages/sim#readme",
  "bugs": "https://github.com/midnightntwrk/midnight-examples/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json && node ../../scripts/pack-extras.mjs add LICENSE",
    "postpack": "node ../../scripts/pack-extras.mjs remove LICENSE",
    "typecheck": "tsc --noEmit -p .",
    "test:sim": "vitest run"
  },
  "peerDependencies": {
    "@midnight-ntwrk/midnight-js-protocol": "~4.1.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.4"
  }
}
